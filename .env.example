# ─────────────────────────────────────────────────────────
# Xane PMS — Environment Configuration Template
# Copy this file to .env before deploying to production.
# ─────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────
# PostgreSQL connection string (Supabase connection pooler recommended)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Optional direct DB password override (if using Supabase direct IPv6 connection bypass)
# DB_PASSWORD="your_database_password_here"

# ── Security & Authentication ────────────────────────────
# CRITICAL: Generate a strong, unique 64-character random string for production.
# Example command: openssl rand -base64 32
JWT_SECRET="generate_a_cryptographically_secure_random_string_here"

# ── PhonePe Payment Gateway Integration ─────────────────
# Get credentials from your PhonePe Merchant Dashboard
PHONEPE_MERCHANT_ID="your_phonepe_merchant_id"
PHONEPE_SALT_KEY="your_phonepe_salt_key"
PHONEPE_SALT_INDEX="1"
PHONEPE_ENV="PROD" # 'PROD' or 'UAT'
PHONEPE_HOST_URL="https://api.phonepe.com/apis/hermes" # Sandbox: https://api-preprod.phonepe.com/apis/pg-sandbox

# ── Razorpay Payment Gateway (Optional / Alternative) ────
# Get credentials from your Razorpay Dashboard (Settings -> API Keys)
# Keep the KEY_SECRET strictly private on the backend!
RAZORPAY_KEY_ID="rzp_live_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key_here"

# Frontend Public Razorpay Key ID (Prefix with VITE_ for Vite bundle)
VITE_RAZORPAY_KEY_ID="rzp_live_your_key_id_here"

# ── Super Admin Portal ───────────────────────────────────
# Master credentials for super-admin portal (/super-admin)
SUPER_ADMIN_EMAIL="superadmin@yourdomain.com"
SUPER_ADMIN_PASSWORD="set_a_strong_unique_password_here"

# ── Application URLs ─────────────────────────────────────
PORT=3000
FRONTEND_URL="https://yourdomain.com"

# ── Email Service (Resend REST API) ──────────────────────
# Obtain key at: https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"
SMTP_PASS="re_your_api_key_here"
SMTP_FROM='"Your Hotel PMS" <noreply@yourdomain.com>'

# ── TLS / SSL Strictness ─────────────────────────────────
# Set to 'false' in production. Never enable in production environments!
ALLOW_INSECURE_TLS="false"
